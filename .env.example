# Lo único que Vercel necesita para publicar el sitio.
ADMIN_PASSWORD=atelier

# Cuando tengas el dominio, poné la URL pública (sin barra al final).
# Hasta entonces Vercel usa sola la URL .vercel.app.
# NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# Opcional: agregalas después, cuando tengas el proyecto de Supabase.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
